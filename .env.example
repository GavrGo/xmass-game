# Адрес вашего проекта Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=
# Публичный ключ anon (Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=
# Токен бота от @BotFather. НЕ используется в браузерном коде!
# Нужен только будущей серверной части (проверка initData). Не коммитьте и не публикуйте.
VITE_BOT_TOKEN=
# Только для теста в обычном браузере (вне Telegram): ваш условный telegram_id.
# Для админки впишите сюда тот же id, что добавили в таблицу admins.
VITE_DEV_TELEGRAM_ID=
